# API Ключ Gemini (получить бесплатно на https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini по умолчанию
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Настройки озвучки (Edge-TTS)
DEFAULT_TTS_VOICE=ru-RU-DmitryNeural
DEFAULT_TTS_RATE=+0%
DEFAULT_TTS_CONCURRENCY=4
DEFAULT_TTS_CHUNK_SIZE=2000

# (Опционально) Google Custom Search API для веб-поиска изображений
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# (Опционально) Pexels API Key
PEXELS_API_KEY=
